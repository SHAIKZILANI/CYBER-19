# ==============================================================================
# CYBER-19 Environment Variables Template (.env.example)
#
# INSTRUCTIONS FOR TEAMMATES:
# 1. Copy this file to '.env' in the project root:
#      Copy-Item .env.example .env
# 2. Modify values only if your local setup differs from the defaults below.
# 3. DO NOT commit your local '.env' file containing real secrets to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MySQL 8)
# Used by Spring Boot backend (backend/src/main/resources/application.properties)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cyber_vulnerability_db
DB_USERNAME=root
DB_PASSWORD=root

# ------------------------------------------------------------------------------
# 2. Backend Orchestration Service
# Default port is 8081 (Spring Boot REST API)
# ------------------------------------------------------------------------------
SERVER_PORT=8081

# ------------------------------------------------------------------------------
# 3. OWASP ZAP Benchmark Scanner Engine
# Managed via docker-compose.lab.yml (mapped to port 8080 on 127.0.0.1)
# ------------------------------------------------------------------------------
ZAP_BASE_URL=http://localhost:8080
ZAP_API_KEY=

# ------------------------------------------------------------------------------
# 4. Frontend Development Server (React 18 + Vite)
# Proxies /api requests to http://localhost:8081
# ------------------------------------------------------------------------------
VITE_PORT=5173

# ------------------------------------------------------------------------------
# 5. Local Docker Security Testing Lab Ports (Reference)
# Configured in docker-compose.lab.yml
# ------------------------------------------------------------------------------
# JUICE_SHOP_PORT=3000   (OWASP Juice Shop)
# DVWA_PORT=8082         (Damn Vulnerable Web App)
# WEBGOAT_PORT=8084      (OWASP WebGoat - remapped from 8080)
# ZAP_PORT=8080          (OWASP ZAP Daemon)
