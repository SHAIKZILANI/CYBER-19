# CYBER-19 Environment Variables Template
# Copy this file to .env and adjust variables as needed

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cyber_vulnerability_db
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# Backend Service
SERVER_PORT=8081

# OWASP ZAP Benchmark Integration
ZAP_HOST=localhost
ZAP_PORT=8080
ZAP_API_KEY=

# Frontend Development Server
VITE_PORT=5173
